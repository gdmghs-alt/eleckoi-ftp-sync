{
  "name": "eleckoi-ftp-sync",
  "version": "0.3.0",
  "type": "module",
  "description": "ElecKoi 数据 FTP 镜像搬运：一个是把远端清空后整份上传，一个是把本机清空后整份下载（下载走守护进程，先备份再清）。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "keywords": [
    "eleckoi",
    "dsh",
    "dsh-plugin",
    "ftp",
    "sync",
    "backup"
  ],
  "engines": {
    "node": ">=20"
  }
}
